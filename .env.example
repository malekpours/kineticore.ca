# Kineticore contact form - Gmail SMTP settings (template)
# Copy this file to .env at the site root, fill in real values, and deploy.

# 1) Turn on 2-Step Verification for this Google account
# 2) Create an App Password: https://myaccount.google.com/apppasswords
# 3) Paste the 16-character app password below (with or without spaces)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your.address@gmail.com
SMTP_PASS=abcdefghijklmnop

# Where enquiries are delivered (From is always the SMTP_USER account)
MAIL_TO=info@kineticore.ca
MAIL_FROM_NAME=Kineticore Website

# 1 = test mode: the form returns "Debug:" with the rendered email, nothing is sent
MAIL_DEBUG=0
